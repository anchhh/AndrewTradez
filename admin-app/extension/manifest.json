{
  "manifest_version": 3,
  "name": "Estly Lead Clipper",
  "version": "1.3.0",
  "description": "Capture the listing you're viewing into your Estly lead pipeline from a persistent side panel. Auto-updates as you browse between listings.",
  "action": {
    "default_title": "Estly Lead Clipper — click to capture this page"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://claude.ai/*"],
      "js": ["watcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/code/artifact/5727f6c4-e2cf-4cc4-9741-a31b1fa6e1ae*"],
      "js": ["demo-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:5050/*",
    "http://127.0.0.1:5050/*",
    "https://claude.ai/code/artifact/5727f6c4-e2cf-4cc4-9741-a31b1fa6e1ae*"
  ],
  "options_page": "options.html"
}
