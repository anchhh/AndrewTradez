{
  "manifest_version": 3,
  "name": "Estly Lead Clipper",
  "version": "2.9.9",
  "description": "Capture the listing you're viewing straight into your Estly leads, from a persistent side panel.",
  "action": {
    "default_title": "Estly Lead Clipper \u2014 click to capture this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://estly-admin.onrender.com/*",
    "http://localhost:5050/*",
    "http://127.0.0.1:5050/*",
    "http://localhost:5051/*",
    "http://127.0.0.1:5051/*",
    "*://*.zillow.com/*",
    "*://*.redfin.com/*",
    "*://*.homes.com/*"
  ],
  "options_page": "options.html"
}